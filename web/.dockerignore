# The build context is web/ itself, so the repository root's .dockerignore does not
# apply here. Without this, `node_modules` is uploaded to the daemon on every build.
node_modules
dist
.vite
# Regenerated from the backend by `npm run api`; the committed client is what builds.
openapi.json
scripts
eslint.config.js

# Berkeley Mono is licensed and must never enter an image. Local development symlinks the
# real faces into `public/fonts/berkeley/` and `vite build` copies whatever it finds in
# `public/` into `dist/`, so without this a build run on the machine that holds the
# licence would quietly bake the fonts into the image it produces. They arrive at runtime
# instead, as a read-only bind mount — see compose.yaml.
public/fonts/berkeley
