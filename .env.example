# Copy to .env. Never commit .env.

# Discord bot token — the bot uses it on the gateway, the backend over REST.
#
# The application needs the SERVER MEMBERS intent enabled in Discord's developer portal.
# Without it Discord never sends GUILD_MEMBER_ADD, so a listed user who joins is not
# banned at the door — and nothing else looks wrong. The hourly sweep still catches them.
TIMOTHY_DISCORD_TOKEN=

# Shared secret between the bot and the backend. Every API call presents it as a bearer
# token; nginx proxies /api from the public tunnel, so without it an identity assertion
# would be an authority assertion. Generate one with: openssl rand -hex 32
TIMOTHY_INTERNAL_TOKEN=

# The one guild whose administrators own pools and listings (ADR 0001). Leaving it unset
# closes pool management rather than opening it — nobody is an administrator of guild 0.
TIMOTHY_MANAGEMENT_GUILD_ID=

# Cloudflare Tunnel token. The tunnel's only origin should be http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Record every enforcement, issue nothing to Discord. Fails safe: anything unreadable
# reads as on. Only 0, false, f, no, n or off switch it off.
TIMOTHY_DRY_RUN=true

# The pool a guild is subscribed to when Timothy joins it (ADR 0002). An ordinary pool
# its administrators can leave, not a reserved name. Empty disables the behaviour.
TIMOTHY_AUTO_SUBSCRIBE_POOL=global

# Durations are seconds, or ISO 8601 (PT1H).
TIMOTHY_PERMISSION_CACHE_TTL=60

# How often to start a round of sweeps. Weekly, and that is not conservatism.
#
# A round costs one Discord member lookup per listed user per pool their guild subscribes
# to. The worker holds one job at a time and awaits each call, so they go out serially at
# roughly two a second — for the migrated data, ~347,000 lookups and about 48 hours. A
# guild with a sweep still outstanding is skipped, so an interval shorter than a round
# does not sweep more often; it just leaves the backend making Discord calls continuously
# and forever.
#
# Weekly means two days of work and five days quiet, on a period that is actually the
# period. Set it shorter only after measuring a round: `SELECT COUNT(*) FROM jobs WHERE
# kind='enforce_guild' AND status='pending'` should reach zero well inside it.
#
# The 48 hours is serial issuance, not Discord's pacing — per-guild buckets cap around
# five calls a second and separate guilds have separate buckets, so sweeping guilds
# concurrently reaches ~43/s and a round drops to a couple of hours. Deferred until the
# system has run a while; see docs/handoffs/phase-5.md.
TIMOTHY_SWEEP_INTERVAL=604800

# Bans in one guild in a single fan-out before the circuit breaker halts the run and
# pauses that guild (ADR 0007). A genuine bulk listing will trip it and need an explicit
# resume; that is the intended trade. Adjustable at runtime, not a redeploy.
TIMOTHY_ENFORCEMENT_BURST_LIMIT=25

# The enforcement worker and the sweep scheduler run inside the backend (ADR 0003).
# Turning them off leaves the API serving and the queue accumulating — useful for a
# read-only maintenance window, not for normal operation.
TIMOTHY_WORKERS_ENABLED=true
TIMOTHY_JOB_POLL_INTERVAL=1
TIMOTHY_JOB_MAX_ATTEMPTS=5

# The bot's gateway connection. Off leaves the process up and the backend reachable but
# never logs in to Discord — for CI, where the token is a placeholder.
TIMOTHY_GATEWAY_ENABLED=true

# Upload the slash command tree on startup. Registration lives in the bot now, replacing
# the old `slash_cli` tool. Turn it off for a second instance run against the same Discord
# application, which would otherwise overwrite the live command surface just by starting.
TIMOTHY_SYNC_COMMANDS=true

# info | debug | warning
TIMOTHY_LOG_LEVEL=info
