# Copy to .env. Never commit .env.

# Discord bot token — the bot uses it on the gateway, the backend over REST.
TIMOTHY_DISCORD_TOKEN=

# Shared secret between the bot and the backend. Every API call presents it as a bearer
# token; nginx proxies /api from the public tunnel, so without it an identity assertion
# would be an authority assertion. Generate one with: openssl rand -hex 32
TIMOTHY_INTERNAL_TOKEN=

# The one guild whose administrators own pools and listings (ADR 0001). Leaving it unset
# closes pool management rather than opening it — nobody is an administrator of guild 0.
TIMOTHY_MANAGEMENT_GUILD_ID=

# Cloudflare Tunnel token. The tunnel's only origin should be http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Record every enforcement, issue nothing to Discord. Fails safe: anything unreadable
# reads as on. Only 0, false, f, no, n or off switch it off.
TIMOTHY_DRY_RUN=true

# The pool a guild is subscribed to when Timothy joins it (ADR 0002). An ordinary pool
# its administrators can leave, not a reserved name. Empty disables the behaviour.
TIMOTHY_AUTO_SUBSCRIBE_POOL=global

# Durations are seconds, or ISO 8601 (PT1H).
TIMOTHY_PERMISSION_CACHE_TTL=60
TIMOTHY_SWEEP_INTERVAL=3600
TIMOTHY_ENFORCEMENT_BURST_LIMIT=25

# info | debug | warning
TIMOTHY_LOG_LEVEL=info
