# Copy to .env. Never commit .env.

# Discord bot token — the bot uses it on the gateway, the backend over REST.
#
# The application needs the SERVER MEMBERS intent enabled in Discord's developer portal.
# Without it Discord never sends GUILD_MEMBER_ADD, so a listed user who joins is not
# banned at the door — and nothing else looks wrong. The weekly sweep still catches them.
TIMOTHY_DISCORD_TOKEN=

# Shared secret between the bot and the backend. Every API call presents it as a bearer
# token; nginx proxies /api from the public tunnel, so without it an identity assertion
# would be an authority assertion. Generate one with: openssl rand -hex 32
TIMOTHY_INTERNAL_TOKEN=

# The one guild whose administrators own pools and listings (ADR 0001). Leaving it unset
# closes pool management rather than opening it — nobody is an administrator of guild 0.
TIMOTHY_MANAGEMENT_GUILD_ID=

# Your Discord user ID — whoever runs this deployment (ADR 0011).
#
# Gates the operations view at /ops, and nothing else: the queue, every server's
# enforcement failures in one list, and the settings the backend is actually running
# with. Administering the management server makes somebody responsible for the pools, not
# for Timothy itself, so this is a separate and much smaller list.
#
# Unset closes /ops for EVERYBODY, including management-guild administrators. It never
# falls back to them. A mistyped ID has the same effect, and the symptom is a 403 rather
# than an error message — check here first if the Operations tab has gone missing.
#
# Usually one ID. Comma-separated if a deployment really has more than one operator.
TIMOTHY_OWNER_IDS=

# Cloudflare Tunnel token — just the token, not the whole install command Cloudflare
# shows you. Create the tunnel in the Zero Trust dashboard and give it one public
# hostname route pointing at type HTTP, URL `web:80` (the compose service name, resolved
# on the compose network — nothing is ever published). Do not set an HTTP Host Header
# override on that route: the CSRF check compares the browser's Origin against the Host
# it received, and rewriting the host refuses every state change from the web UI.
# README.md, "Setting up the tunnel", has the walkthrough.
CLOUDFLARE_TUNNEL_TOKEN=

# -- the web UI's login -------------------------------------------------------
#
# The same Discord application as the bot token above, under OAuth2. Leaving these unset
# closes login rather than opening it: /api/auth/login answers 503 and names what is
# missing, and the rest of the stack comes up unaffected.
#
# The redirect URI must be registered under OAuth2 > Redirects EXACTLY as
# <TIMOTHY_PUBLIC_BASE_URL>/api/auth/callback — Discord compares the string, and a
# trailing slash or http-vs-https difference is a failed login with no useful message.
#
# NOT the "Interactions Endpoint URL" field on the General Information page. That is a
# different feature — HTTP delivery of slash commands instead of the gateway — and
# putting the callback there fails to save (Discord POSTs a ping and gets 405 from a
# GET-only route) and would stop the bot receiving commands at all. Leave it empty.
#
# Timothy also has to be invited with the applications.commands scope, not just bot, or
# uploading the pool commands answers 403 Missing Access. See README.md.
#
# Scopes are `identify guilds`, requested by the backend. `guilds` is what lets a browser
# skip the scan of every guild Timothy is in (ADR 0010).
TIMOTHY_DISCORD_CLIENT_ID=
TIMOTHY_DISCORD_CLIENT_SECRET=

# Where a browser reaches Timothy — the Cloudflare Tunnel hostname, with no trailing
# path. It cannot be derived from the request: behind the tunnel and nginx the backend
# only ever sees an internal host.
TIMOTHY_PUBLIC_BASE_URL=https://timothy.example.com

# How long a signed-in browser stays signed in. Also how long the guild snapshot taken at
# login stays current: a guild Timothy joins afterwards is invisible to that session until
# it logs in again (ADR 0010).
TIMOTHY_SESSION_LIFETIME=604800

# Whether the session cookie is `Secure`. On in production, where Cloudflare terminates
# TLS. The only reason to turn it off is a local stack served over plain HTTP — and a
# browser silently dropping the cookie is a confusing way to discover that.
TIMOTHY_SESSION_COOKIE_SECURE=true

# Record every enforcement, issue nothing to Discord. Fails safe: anything unreadable
# reads as on. Only 0, false, f, no, n or off switch it off.
TIMOTHY_DRY_RUN=true

# The pool a guild is subscribed to when Timothy joins it (ADR 0002). An ordinary pool
# its administrators can leave, not a reserved name. Empty disables the behaviour.
TIMOTHY_AUTO_SUBSCRIBE_POOL=global

# Durations are seconds, or ISO 8601 (PT1H).
TIMOTHY_PERMISSION_CACHE_TTL=60

# How often to start a round of sweeps. Weekly, and that is not conservatism.
#
# A round costs one Discord member lookup per listed user per pool their guild subscribes
# to. The worker holds one job at a time and awaits each call, so they go out serially at
# roughly two a second — for the migrated data, ~347,000 lookups and about 48 hours. A
# guild with a sweep still outstanding is skipped, so an interval shorter than a round
# does not sweep more often; it just leaves the backend making Discord calls continuously
# and forever.
#
# Weekly means two days of work and five days quiet, on a period that is actually the
# period. Set it shorter only after measuring a round: `SELECT COUNT(*) FROM jobs WHERE
# kind='enforce_guild' AND status='pending'` should reach zero well inside it.
#
# The 48 hours is serial issuance, not Discord's pacing — per-guild buckets cap around
# five calls a second and separate guilds have separate buckets, so sweeping guilds
# concurrently reaches ~43/s and a round drops to a couple of hours. Deferred until the
# system has run a while; see docs/handoffs/phase-5.md.
TIMOTHY_SWEEP_INTERVAL=604800

# Bans in one guild in a single fan-out before the circuit breaker halts the run and
# pauses that guild (ADR 0007). A genuine bulk listing will trip it and need an explicit
# resume; that is the intended trade. Adjustable at runtime, not a redeploy.
TIMOTHY_ENFORCEMENT_BURST_LIMIT=25

# The enforcement worker and the sweep scheduler run inside the backend (ADR 0003).
# Turning them off leaves the API serving and the queue accumulating — useful for a
# read-only maintenance window, not for normal operation.
TIMOTHY_WORKERS_ENABLED=true
TIMOTHY_JOB_POLL_INTERVAL=1
TIMOTHY_JOB_MAX_ATTEMPTS=5

# The bot's gateway connection. Off leaves the process up and the backend reachable but
# never logs in to Discord — for CI, where the token is a placeholder, and for a local
# stack sharing a token with a bot that is already live. See README.md, "Trying it out
# before the cutover".
TIMOTHY_GATEWAY_ENABLED=true

# Upload the slash command tree on startup. Registration lives in the bot now, replacing
# the old `slash_cli` tool. Turn it off for a second instance run against the same Discord
# application, which would otherwise overwrite the live command surface just by starting.
TIMOTHY_SYNC_COMMANDS=true

# info | debug | warning
TIMOTHY_LOG_LEVEL=info

# The web UI offers two themes, and the industrial one is designed against Berkeley Mono
# (U.S. Graphics Company). That typeface is licensed rather than open, so it is in neither
# this repository nor the image compose builds — `.gitignore` and `web/.dockerignore` both
# exclude it. Point this at an unpacked copy of the web faces on this host to serve it;
# compose mounts the directory read-only into nginx.
#
# Left unset, the industrial theme renders in IBM Plex Mono, which is committed under the
# SIL Open Font License and ships in the image. Nothing breaks and nothing warns — the
# licensed face is simply first in a font stack, and a missing one falls through.
TIMOTHY_BERKELEY_MONO_DIR=
